# Development defaults. Use a long unique password on the Ubuntu server.
POSTGRES_DB=football
POSTGRES_USER=football
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# 127.0.0.1: only a reverse proxy on the host can reach the API. Docker-published ports bypass
# the host firewall, so use 0.0.0.0 only on a trusted network.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
# The landing page (web service); bound like the API, behind the same reverse proxy.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8001
# Optional override; by default the User-Agent includes the package version.
# FOOTBALL_RESULTS_USER_AGENT="FootballResultsAPI (contact: you@example.com)"
FOOTBALL_RESULTS_SCHEDULER_LOOP_SECONDS=30
FOOTBALL_RESULTS_SCHEDULER_CLAIM_LIMIT=5
# Comma-separated admin keys (named `env` in metrics). Prefer the keys file below for named keys
# with roles and quotas; both can be used together.
FOOTBALL_RESULTS_API_KEYS=
# YAML file of hashed, expiring keys; manage it on the host with
# `python -m app.config keys --file secrets/api-keys.yaml issue|extend|revoke|list`.
# With Docker Compose, put it in ./secrets/ (git-ignored, mounted read-only at /app/secrets);
# the API reloads it on change.
# FOOTBALL_RESULTS_API_KEYS_FILE=/app/secrets/api-keys.yaml
# false = private instance (docs/PRIVATE.md): every API operation except /health needs a key from
# the keys file; FOOTBALL_RESULTS_API_KEYS must be empty and the public base URL https.
FOOTBALL_RESULTS_ANONYMOUS_ACCESS=true
# Privacy (/privacy): operator contact (required in demo mode), access-log retention in days, and
# whether access logs shorten client IPs to their network (always on in demo mode).
# FOOTBALL_RESULTS_OPERATOR_CONTACT=you@example.com
# FOOTBALL_RESULTS_LOG_RETENTION_DAYS=14
# FOOTBALL_RESULTS_ANONYMIZE_LOG_IPS=false
# Telegram message to the operator on each new access request (ID, name, client type, intended
# use, competitions; never the contact email or message). Set both or neither. Docker Compose
# falls back to TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID below (the Grafana alert chat); set these to
# send access requests to another chat.
# FOOTBALL_RESULTS_TELEGRAM_BOT_TOKEN=
# FOOTBALL_RESULTS_TELEGRAM_CHAT_ID=
FOOTBALL_RESULTS_FOOTBALL_DATA_API_TOKEN=
FOOTBALL_RESULTS_FOOTBALL_DATA_MIN_REQUEST_INTERVAL_SECONDS=6
# Minimum delay between ESPN requests (default 2 from config/competitions.yaml).
# FOOTBALL_RESULTS_ESPN_MIN_REQUEST_INTERVAL_SECONDS=2
# TheSportsDB fallback source: empty uses the free public key 123; set a premium key to override.
# FOOTBALL_RESULTS_THESPORTSDB_API_KEY=
# Minimum delay between TheSportsDB requests (default 3 from config/competitions.yaml).
# FOOTBALL_RESULTS_THESPORTSDB_MIN_REQUEST_INTERVAL_SECONDS=3
# Minimum delay between OpenLigaDB requests (default 2 from config/competitions.yaml).
# FOOTBALL_RESULTS_OPENLIGADB_MIN_REQUEST_INTERVAL_SECONDS=2
# API rate limits and caching (defaults shown).
# FOOTBALL_RESULTS_RATE_LIMIT_ENABLED=true
# FOOTBALL_RESULTS_RATE_LIMIT_READ_PER_MINUTE=120
# FOOTBALL_RESULTS_RATE_LIMIT_WRITE_PER_MINUTE=10
# Proxy IPs/CIDRs whose X-Forwarded-For is trusted, e.g. 172.16.0.0/12 behind a host proxy.
# FOOTBALL_RESULTS_TRUSTED_PROXIES=
# FOOTBALL_RESULTS_CACHE_MAX_AGE_SECONDS=60
# Public URL used in /llms.txt and /agents; empty derives it from the request Host.
# FOOTBALL_RESULTS_PUBLIC_BASE_URL=https://football.example.com
# Extra Host and Origin values accepted by /mcp (localhost and the public URL are always allowed).
# FOOTBALL_RESULTS_MCP_ALLOWED_HOSTS=football.internal:8000
# FOOTBALL_RESULTS_MCP_ALLOWED_ORIGINS=https://chat.example.com

# Optional OAuth for /mcp (ADR 0006). Off while the issuer is empty; needs PUBLIC_BASE_URL.
# The oauth-example profile (docker compose --profile oauth-example up -d keycloak) runs Keycloak:
# FOOTBALL_RESULTS_PUBLIC_BASE_URL=http://localhost:8000
# FOOTBALL_RESULTS_OAUTH_ISSUER=http://localhost:8080/realms/football
# FOOTBALL_RESULTS_OAUTH_JWKS_URL=http://keycloak:8080/realms/football/protocol/openid-connect/certs
# FOOTBALL_RESULTS_OAUTH_MODE=optional
# FOOTBALL_RESULTS_OAUTH_SCOPES=mcp:tools
# Token audience when it is not the public /mcp URL (default: PUBLIC_BASE_URL + /mcp).
# FOOTBALL_RESULTS_OAUTH_AUDIENCE=
# Keycloak admin console login of the oauth-example profile (choose your own password).
# KEYCLOAK_ADMIN_PASSWORD=

# Public read-only demo instance (ADR 0007, docs/DEMO.md); compose.demo.yaml sets it. Rejects
# admin keys and providers that are not publicly redistributable.
# FOOTBALL_RESULTS_DEMO_MODE=false
# Anonymous reads per minute per IP on the demo (compose.demo.yaml, default 30).
# DEMO_READ_PER_MINUTE=30

# Log format of the API and scheduler: text or json (Docker Compose defaults to json).
# FOOTBALL_RESULTS_LOG_FORMAT=json

# Observability profile (docker compose --profile observability up -d).
# PROMETHEUS_API_KEY must be an admin key: listed in FOOTBALL_RESULTS_API_KEYS or the keys file
# (on a private instance only the keys file; rotate it before it expires).
PROMETHEUS_API_KEY=
# PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_PASSWORD=change-me
# GRAFANA_BIND_ADDRESS=127.0.0.1
# GRAFANA_PORT=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Used when running FastAPI directly instead of through Docker Compose.
FOOTBALL_RESULTS_DATABASE_URL=postgresql+psycopg_async://football:change-me@localhost:5432/football
