# Development defaults. Use a long unique password on the Ubuntu server.
POSTGRES_DB=football
POSTGRES_USER=football
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

API_BIND_ADDRESS=0.0.0.0
API_PORT=8000
# Optional override; by default the User-Agent includes the package version.
# FOOTBALL_RESULTS_USER_AGENT="FootballResultsAPI (contact: you@example.com)"
FOOTBALL_RESULTS_SCHEDULER_LOOP_SECONDS=30
FOOTBALL_RESULTS_SCHEDULER_CLAIM_LIMIT=5
FOOTBALL_RESULTS_FOOTBALL_DATA_API_TOKEN=
FOOTBALL_RESULTS_FOOTBALL_DATA_MIN_REQUEST_INTERVAL_SECONDS=6

# Used when running FastAPI directly instead of through Docker Compose.
FOOTBALL_RESULTS_DATABASE_URL=postgresql+psycopg_async://football:change-me@localhost:5432/football
