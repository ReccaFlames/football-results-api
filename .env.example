# Development defaults. Use a long unique password on the Ubuntu server.
POSTGRES_DB=football
POSTGRES_USER=football
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

API_BIND_ADDRESS=0.0.0.0
API_PORT=8000
# Optional override; by default the User-Agent includes the package version.
# FOOTBALL_RESULTS_USER_AGENT="FootballResultsAPI (contact: you@example.com)"
FOOTBALL_RESULTS_SCHEDULER_LOOP_SECONDS=30
FOOTBALL_RESULTS_SCHEDULER_CLAIM_LIMIT=5
FOOTBALL_RESULTS_API_KEYS=
FOOTBALL_RESULTS_FOOTBALL_DATA_API_TOKEN=
FOOTBALL_RESULTS_FOOTBALL_DATA_MIN_REQUEST_INTERVAL_SECONDS=6
# Minimum delay between ESPN requests (default 2 from config/competitions.yaml).
# FOOTBALL_RESULTS_ESPN_MIN_REQUEST_INTERVAL_SECONDS=2
# TheSportsDB fallback source: empty uses the free public key 123; set a premium key to override.
# FOOTBALL_RESULTS_THESPORTSDB_API_KEY=
# Minimum delay between TheSportsDB requests (default 3 from config/competitions.yaml).
# FOOTBALL_RESULTS_THESPORTSDB_MIN_REQUEST_INTERVAL_SECONDS=3
# API rate limits and caching (defaults shown).
# FOOTBALL_RESULTS_RATE_LIMIT_ENABLED=true
# FOOTBALL_RESULTS_RATE_LIMIT_READ_PER_MINUTE=120
# FOOTBALL_RESULTS_RATE_LIMIT_WRITE_PER_MINUTE=10
# Proxy IPs/CIDRs whose X-Forwarded-For is trusted, e.g. 172.16.0.0/12 behind a host proxy.
# FOOTBALL_RESULTS_TRUSTED_PROXIES=
# FOOTBALL_RESULTS_CACHE_MAX_AGE_SECONDS=60
# Public URL used in /llms.txt and /agents; empty derives it from the request Host.
# FOOTBALL_RESULTS_PUBLIC_BASE_URL=https://football.example.com
# Extra Host and Origin values accepted by /mcp (localhost and the public URL are always allowed).
# FOOTBALL_RESULTS_MCP_ALLOWED_HOSTS=football.internal:8000
# FOOTBALL_RESULTS_MCP_ALLOWED_ORIGINS=https://chat.example.com

# Log format of the API and scheduler: text or json (Docker Compose defaults to json).
# FOOTBALL_RESULTS_LOG_FORMAT=json

# Observability profile (docker compose --profile observability up -d).
# PROMETHEUS_API_KEY must also be listed in FOOTBALL_RESULTS_API_KEYS.
PROMETHEUS_API_KEY=
# PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_PASSWORD=change-me
# GRAFANA_BIND_ADDRESS=127.0.0.1
# GRAFANA_PORT=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Used when running FastAPI directly instead of through Docker Compose.
FOOTBALL_RESULTS_DATABASE_URL=postgresql+psycopg_async://football:change-me@localhost:5432/football
